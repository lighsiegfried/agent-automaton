# Copy this file to .env and adjust values as needed.

# Identity: the assistant persona name (used in replies, /identity, CLI).
# WAKE_WORD is future metadata only — no wake word listening exists yet.
AGENT_NAME=Fifi
WAKE_WORD=fifi

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:7b

# Local persistent runtime (Phase 3B.7). scripts/local_runtime.py runs the API
# on the Windows host and keeps Dockerized Ollama (GPU-first) up as a support
# service. Defaults are safe and local-only and never change tool permissions.
API_HOST=127.0.0.1
API_PORT=8000
# start also brings up Dockerized Ollama (set false to manage Ollama yourself)
RUNTIME_AUTO_START_OLLAMA=true
# require the GPU; CPU inference still needs the explicit ALLOW_CPU_OLLAMA=true
RUNTIME_REQUIRE_GPU=true
# stop leaves Ollama running by default (persistent). false = stop it too.
RUNTIME_KEEP_OLLAMA_RUNNING=true

# Persistent warm runtime (Phase 3D.1). start/restart preload the LLM into
# VRAM (keep_alive=-1) and prewarm STT so the first command is never cold.
# `python scripts/local_runtime.py unload` releases VRAM (keep_alive=0) and
# never deletes models or volumes.
RUNTIME_PREWARM_LLM=true
RUNTIME_PREWARM_STT=true
# Fail the warmup when the model is (partially) CPU-offloaded, unless
# ALLOW_CPU_OLLAMA=true or this is set to false.
OLLAMA_REQUIRE_FULL_GPU=true
# keep_alive=-1: the model stays loaded until an explicit unload.
OLLAMA_KEEP_MODEL_LOADED=true
# The model-keeper compose service re-warms the model after an Ollama restart.
MODEL_KEEPER_CHECK_SECONDS=60

# LLM command planner (Phase 2). false = rule-based router only (default).
# true = Ollama proposes a command plan; the plan is strictly validated
# (known tools only, no destructive actions, no unexpected arguments) and
# still passes the normal safety layer. Any failure falls back to the rules.
ENABLE_LLM_PLANNER=false
LLM_PLANNER_MODEL=qwen2.5:7b
LLM_PLANNER_TIMEOUT_SECONDS=20

# Dockerized Ollama is GPU-first: scripts/docker_llm.py refuses to run
# CPU-only inference unless this is explicitly set to true.
ALLOW_CPU_OLLAMA=false

# Assistant response generator (Phase 3B). false = short deterministic
# bilingual template replies (default). true = Ollama phrases the reply;
# templates remain the fallback when Ollama is unavailable.
ENABLE_RESPONSE_GENERATOR=false
RESPONSE_MODEL=qwen2.5:7b
RESPONSE_TIMEOUT_SECONDS=15

# Voice (Phase 3A). Disabled by default; requires the optional dependencies:
#   pip install -r requirements-voice.txt
# Voice commands go through the exact same /command safety pipeline.
ENABLE_VOICE=false
STT_MODEL=small
# Blackwell-safe defaults (Phase 3C.1). RTX 50 (sm_120) needs float16, NOT INT8
# (INT8 cuBLAS variants raise CUBLAS_STATUS_NOT_SUPPORTED). "auto" resolves to
# float16 on Blackwell at load time; keep ctranslate2>=4.8.1 installed.
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# CPU inference is opt-in only. When true, a failed CUDA load falls back to
# device=cpu, compute_type=int8 (slow) instead of erroring.
STT_ALLOW_CPU_FALLBACK=false
VOICE_LANGUAGE=auto
# TTS engine: "voice_lab" = neural voices from the isolated Voice Lab worker
# (Phase 3D.0; falls back to Windows TTS when the worker is down),
# "windows" = SAPI directly, "simulated" = never speak.
TTS_ENGINE=voice_lab

# Voice Lab (Phase 3D.0). Isolated laboratory under voice_lab/ with its own
# venv, models, and cache — set it up once with:
#   python voice_lab/scripts/setup.py
#   python scripts/local_runtime.py voice-start
# The active voice is config/voices/active.json (change it with
#   python voice_lab/scripts/voice_lab.py select <profile>).
VOICE_LAB_URL=http://127.0.0.1:8766
# Where the Voice Lab worker runs: "host" (isolated voice_lab/.venv, default) or
# "docker" (the compose `voice-lab` container). In docker mode voice-start /
# voice-stop / voice-status / voice-warm / voice-ui orchestrate the container
# instead of a host process; PTT, wake word, and Windows automation stay
# host-only either way, and only ONE worker ever owns port 8766.
#   Seed the model cache once:  docker compose --profile voice-seed up voice-model-seed
#   Then:  docker compose --profile voice up -d voice-lab   (or voice-start)
VOICE_LAB_RUNTIME=host
VOICE_PROFILE=fifi_warm
VOICE_LAB_TIMEOUT_SECONDS=60
# How long voice-warm / voice-preview wait for the async worker job.
VOICE_LAB_WARM_TIMEOUT_SECONDS=300
# When the worker is unavailable, fall back to the existing Windows TTS.
VOICE_LAB_ALLOW_FALLBACK=true
# Optionally bring the Voice Lab up with `start` (it stays optional either
# way) and prewarm the active voice so the first reply is instant.
RUNTIME_AUTO_START_VOICE_LAB=false
RUNTIME_PREWARM_TTS=true
VOICE_RECORD_SECONDS=5
VOICE_SAMPLE_RATE=16000
# Speak the assistant reply out loud after /voice/command (needs pyttsx3)
VOICE_SPEAK_COMMAND_RESPONSE=false

# Push-to-talk desktop client (Phase 3C). Host-only client (scripts/fifi_ptt.py),
# launched with:  python scripts/local_runtime.py ptt
# Requires the desktop dependencies:  pip install -r requirements-desktop.txt
# These configure the client only — they never change the safety layer. No
# always-on microphone and no wake word: recording happens only while the key
# is held.
ENABLE_PUSH_TO_TALK=false
PTT_HOTKEY=ctrl+alt+space
PTT_MAX_SECONDS=20
PTT_MIN_SECONDS=0.4
PTT_CONFIRM_WINDOW_SECONDS=30
PTT_AUDIO_FEEDBACK=true
PTT_INPUT_DEVICE=default

# Wake-word runtime (Phase 3D.1). Host-only listener (scripts/fifi_wake.py),
# launched explicitly with:  python scripts/local_runtime.py wake
# Requires the wake dependencies:  pip install -r requirements-wakeword.txt
# and a CUSTOM model at WAKE_WORD_MODEL_PATH — it is NEVER downloaded or
# replaced automatically; when missing, wake listening reports unavailable.
# Idle audio is never retained; command WAVs are deleted after sending unless
# WAKE_WORD_STORE_AUDIO=true. Wake commands use the same /voice/command
# safety pipeline as push-to-talk. Never auto-started.
ENABLE_WAKE_WORD=false
WAKE_WORD_MODEL_PATH=models/wake_words/fifi.onnx
WAKE_WORD_THRESHOLD=0.55
WAKE_WORD_COOLDOWN_SECONDS=2
# Microphone for the wake listener ("default" = system default; falls back to
# PTT_INPUT_DEVICE when unset).
WAKE_WORD_INPUT_DEVICE=default
# Short acknowledgment beep on wake detection / send (client-side only).
WAKE_WORD_AUDIO_FEEDBACK=true
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=900
VAD_MAX_COMMAND_SECONDS=20
# Daily wake-mode TTS latency guard (Phase 3D.1): if the active (possibly Qwen)
# voice can't synthesize the spoken reply within this budget, fall back to
# Kokoro. The command already executed — TTS never delays it. VoiceDesign is
# never loaded for a wake reply.
WAKE_MAX_TTS_WAIT_SECONDS=20
WAKE_WORD_STORE_AUDIO=false
# Mute/unmute hotkey for the wake listener (client-side only).
# (WAKE_MUTE_HOTKEY is still accepted for backward compatibility.)
WAKE_WORD_MUTE_HOTKEY=ctrl+alt+m

# Custom wake model (Phase 3D.2). Train, evaluate, and install it from the
# isolated workspace (its own venv — never the main .venv):
#   python wake_training/scripts/setup.py
#   wake_training/.venv/Scripts/python.exe wake_training/scripts/wake_trainer.py train fifi
#   ... evaluate / compare / install  (writes fifi.onnx + fifi.metadata.json)
# Calibrate the installed threshold live (this NEVER executes a command):
#   python scripts/local_runtime.py wake-calibrate
# Then set WAKE_WORD_THRESHOLD above to the recommended value.

# Optional speaker verifier (Phase 3D.2). DISABLED by default — wake detection
# works fully without it. When enabled AND the verifier file exists, the wake
# service adds an openWakeWord custom-verifier gate trained from YOUR authorized
# samples; it only makes detection stricter and never bypasses VAD, confirmation
# or tool permissions. A missing verifier simply means "not used".
ENABLE_WAKE_WORD_VERIFIER=false
WAKE_WORD_VERIFIER_PATH=models/wake_words/fifi_verifier.pkl
WAKE_WORD_VERIFIER_THRESHOLD=0.3

# System-tray app + controlled auto-start (Phase 3E). The tray
# (scripts/fifi_tray.py) orchestrates the whole stack by reusing local_runtime;
# it starts nothing automatically unless FIFI_AUTO_START=true. Auto-start uses a
# per-user Task Scheduler ONLOGON task (no admin, delayed, no secrets stored):
#   python scripts/local_runtime.py autostart-enable
#   python scripts/local_runtime.py tray            # launch the tray now
FIFI_AUTO_START=false
FIFI_STARTUP_DELAY_SECONDS=20
# Interaction mode entered after a successful start: wake | ptt
FIFI_DEFAULT_INTERACTION_MODE=wake
FIFI_START_MINIMIZED=true
FIFI_AUTO_WARM_LLM=true
FIFI_AUTO_WARM_STT=true
FIFI_AUTO_WARM_TTS=true
# On tray exit, stop the Docker support services too (models/volumes are always
# preserved). Set true to leave Ollama / Voice Lab running after the tray exits.
FIFI_KEEP_OLLAMA_RUNNING_ON_EXIT=false
FIFI_KEEP_VOICE_LAB_RUNNING_ON_EXIT=false

# Controlled text insertion (Phase 4A). Drafting/rewriting text is always safe;
# inserting it into a Windows app is SENSITIVE and simulated unless
# ENABLE_REAL_TEXT_INPUT=true. Real insertion also needs an exact confirmation
# phrase (confirmar escritura / escribirlo / insert text / confirm typing — a
# plain "sí" is not enough), never types into terminals/password/elevated/
# unverified windows, never presses Enter/submit, and never uses the clipboard
# unless TEXT_ALLOW_CLIPBOARD_FALLBACK=true (then it restores the clipboard).
ENABLE_REAL_TEXT_INPUT=false
TEXT_INPUT_REQUIRE_CONFIRMATION=true
TEXT_ACTION_EXPIRES_SECONDS=45
TEXT_MAX_CHARACTERS=5000
TEXT_ALLOWED_APPS=notepad,wordpad,winword,chrome,edge
TEXT_ALLOW_CLIPBOARD_FALLBACK=false
TEXT_BLOCK_PASSWORD_FIELDS=true

# Safe browser automation (Phase 4B). Reading/searching/scrolling/navigating are
# safe; filling a form field is SENSITIVE and needs an exact confirmation phrase
# (confirmar formulario / llenar formulario / confirm form fill). Submitting,
# purchasing, publishing, uploading, deleting, accepting terms, sending, and
# logging in are BLOCKED in this phase. A dedicated ISOLATED Chromium profile is
# used (storage/browser/) — never the user's real browser; cookies are never
# imported or exposed. Install:  pip install -r requirements-browser.txt
#   && python -m playwright install chromium
ENABLE_BROWSER_AUTOMATION=false
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=false
BROWSER_PROFILE_MODE=isolated
BROWSER_ALLOW_EXISTING_PROFILE=false
BROWSER_ALLOWED_SCHEMES=https,http
BROWSER_BLOCK_PRIVATE_NETWORKS=true
BROWSER_REQUIRE_CONFIRMATION_FOR_FORM_FILL=true
BROWSER_ALLOW_FORM_SUBMIT=false
BROWSER_MAX_PAGE_TEXT_CHARS=50000
BROWSER_ACTION_TIMEOUT_SECONDS=30
BROWSER_SESSION_IDLE_SECONDS=600

# WhatsApp Web automation (Phase 4C). Reuses the controlled browser with a
# DEDICATED profile (storage/browser/whatsapp) and manual QR login — never the
# user's normal browser; cookies/tokens/QR are never read or logged. Drafting is
# safe; placing a draft ("colocar borrador") and sending ("confirmar envío a
# <destinatario>") are two separate confirmations, and a send must name the
# recipient. Simulated unless ENABLE_REAL_WHATSAPP_SEND=true. No groups,
# attachments, bulk, or unofficial APIs. Needs requirements-browser.txt.
ENABLE_WHATSAPP_AUTOMATION=false
ENABLE_REAL_WHATSAPP_SEND=false
WHATSAPP_PROFILE_DIR=storage/browser/whatsapp
WHATSAPP_ACTION_EXPIRES_SECONDS=45
WHATSAPP_MAX_MESSAGE_CHARS=4000
WHATSAPP_SEND_COOLDOWN_SECONDS=5
WHATSAPP_REQUIRE_RECIPIENT_IN_CONFIRMATION=true

# Web-email automation (Phase 4D). Reuses the controlled browser with per-provider
# dedicated profiles (storage/browser/email/{gmail,outlook}); manual login only;
# cookies/tokens are never read or logged. Email content is UNTRUSTED — summarized,
# never executed, and in-email instructions are ignored. Drafting is safe; placing
# ("colocar borrador") and sending ("confirmar envío a <destinatarios>") are two
# confirmations, and a send must name all recipients. Reply-all and BCC are blocked.
# Simulated unless ENABLE_REAL_EMAIL_SEND=true. Needs requirements-browser.txt.
ENABLE_EMAIL_WEB_AUTOMATION=false
ENABLE_REAL_EMAIL_SEND=false
EMAIL_ALLOWED_PROVIDERS=gmail,outlook
EMAIL_ACTION_EXPIRES_SECONDS=60
EMAIL_MAX_BODY_CHARS=10000
EMAIL_MAX_RECIPIENTS=3
EMAIL_ALLOW_CC=true
EMAIL_ALLOW_BCC=false
EMAIL_ALLOW_ATTACHMENTS=false
EMAIL_SEND_COOLDOWN_SECONDS=10

# Personal memory (Phase 5A). Explicit, local, auditable memory for Fifi, stored
# in a local SQLite file (WAL + schema migrations) — no cloud dependency. Nothing
# is stored just because it was said: creating/updating/forgetting requires an
# explicit intent ("recuerda que…") that becomes a pending proposal, then an EXACT
# confirmation phrase ("confirmar memoria" / "confirm memory"). A plain "sí", a
# wake, or email/web content NEVER store memory. Sensitive data (passwords, OTPs,
# API keys, cards, private keys, cookies, precise addresses, sensitive personal
# info) is blocked by default and never inferred. Forgetting has two stages:
# "confirmar olvido" (soft, excluded from retrieval) and "eliminar memoria
# permanentemente" (separate confirmation). Retrieval returns only a small bounded
# bundle — never the whole database.
ENABLE_MEMORY=true
MEMORY_DB_PATH=storage/memory/fifi_memory.db
MEMORY_OWNER=local
MEMORY_ACTION_EXPIRES_SECONDS=120
MEMORY_MAX_TITLE_CHARS=200
MEMORY_MAX_CONTENT_CHARS=4000
MEMORY_DEFAULT_CONFIDENCE=0.8
MEMORY_CONTEXT_MAX_ITEMS=5
MEMORY_CONTEXT_MAX_CHARS=1500
MEMORY_SEARCH_MAX_RESULTS=10
MEMORY_LIST_MAX_RESULTS=50
MEMORY_BLOCK_SENSITIVE=true

# Multi-step tasks (Phase 5B). Deterministic, resumable plans over the EXISTING
# services (memory search; browser research; text drafting/insertion; WhatsApp and
# email drafting/sending) with per-effect human confirmation. An LLM may PROPOSE a
# plan, but deterministic code validates every intent/argument against the service
# registry (no arbitrary tools/Python/shell/selectors/unknown URLs), rejects cycles
# and over-long plans, and classifies each step read-only / local / effect. Plan
# approval ("aprobar plan") only lets read-only and local-safe steps begin — it
# NEVER pre-confirms typing, form-fill, WhatsApp or email sending; each effect still
# pauses in the one global broker and needs its own exact domain phrase. One task
# runs effects at a time; nothing auto-resumes after a restart; completed effects
# never run twice. Stored in a separate local SQLite DB (WAL). Off by default.
ENABLE_MULTI_STEP_TASKS=false
TASKS_DB_PATH=storage/tasks/fifi_tasks.db
TASK_OWNER=local
TASK_MAX_STEPS=12
TASK_MAX_RUNTIME_MINUTES=20
TASK_MAX_STEP_RETRIES=1
TASK_REQUIRE_PLAN_APPROVAL=true
TASK_ALLOW_BACKGROUND_EXECUTION=false
TASK_AUTO_RESUME=false
TASK_CONTEXT_MAX_MEMORIES=5
TASK_CONTEXT_MAX_CHARS=2000

# Persistent reminders + scheduled tasks (Phase 5C). Fires reminders and runs
# validated Phase-5B task templates at a time/recurrence, in a separate local SQLite
# DB (WAL). Instants are stored in UTC and resolved through SCHEDULE_TIMEZONE (IANA)
# with explicit daylight-saving handling; relative ES/EN dates are normalized
# deterministically and ambiguous ones ("el viernes" with no time) are refused.
# Creating/modifying a schedule is sensitive — it needs "confirmar programación"
# (a plain "sí"/wake never confirms). One owned scheduler polls every
# SCHEDULE_POLL_SECONDS and takes an atomic per-run lease so a restart or clock
# change can't double-run. At run time the plan is REVALIDATED and memory context
# recomputed: read-only and local-draft steps may auto-run, but every external
# effect pauses in the broker for a fresh domain confirmation — schedule approval
# never pre-confirms an effect. Off by default. (Requires tzdata; see requirements.txt.)
ENABLE_SCHEDULES=false
SCHEDULES_DB_PATH=storage/schedules/fifi_schedules.db
SCHEDULE_OWNER=local
SCHEDULE_TIMEZONE=America/Guatemala
SCHEDULE_POLL_SECONDS=15
SCHEDULE_MISFIRE_GRACE_SECONDS=300
SCHEDULE_MAX_BACKLOG_RUNS=3
SCHEDULE_MAX_ACTIVE_RUNS=1
SCHEDULE_ALLOW_READ_ONLY_AUTORUN=true
SCHEDULE_ALLOW_LOCAL_DRAFT_AUTORUN=true
SCHEDULE_ALLOW_EXTERNAL_EFFECT_AUTORUN=false

# Local Activity Center (Phase 5D). A read-optimized, localhost-only observability +
# safe-control UI at http://127.0.0.1:<api-port>/activity. It AGGREGATES safe events
# from every subsystem via additive event hooks (subsystems never depend on the UI)
# into a separate local SQLite DB (WAL). It stores only redacted, allowlisted metadata
# — never secrets, tokens, cookies, form values, or full email/message/draft bodies.
# Every control it offers (confirm/cancel a pending action; approve/resume/cancel a
# task; pause/resume/cancel a schedule; retry health; restart an OWNED service; release
# VRAM) routes through the EXISTING services and the one global broker — it never
# mutates a subsystem DB directly, never offers a generic "confirm everything", and
# never kills unrelated processes. Event writes never block command execution.
ENABLE_ACTIVITY_CENTER=true
ACTIVITY_DB_PATH=storage/activity/fifi_activity.db
ACTIVITY_OWNER=local
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_MAX_EVENTS=50000
ACTIVITY_REDACT_CONTENT=true
ACTIVITY_UI_HOST=127.0.0.1
ACTIVITY_UI_PORT=8770
ACTIVITY_ENABLE_EXPORT=true

# Local document Knowledge Vault (Phase 6A). Citation-grounded RAG over explicitly
# authorized local documents (PDF/TXT/Markdown/DOCX/CSV). Document content is UNTRUSTED
# data: in-document instructions ("ignore rules", "reveal secrets", "run commands",
# "send email", "modify memory", "open link") are flagged and NEVER acted on — a
# document can inform an answer but never authorizes an action or modifies memory.
# Embeddings are generated by a LOCAL model (deterministic hash fallback; optional
# sentence-transformers) — documents are never sent to an external API. Retrieval is
# hybrid (FTS5 + local vectors) and bounded; every document-derived answer cites
# filename + page/section or states insufficient evidence, with no fabricated citation.
# Deleting a document needs "confirmar eliminación de documento" (a plain "sí"/wake
# never confirms) and never deletes personal memories. OCR is off and never automatic.
ENABLE_KNOWLEDGE_VAULT=false
KNOWLEDGE_MAX_FILE_MB=50
KNOWLEDGE_MAX_PAGES=1000
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_MAX_RESULTS=8
KNOWLEDGE_CONTEXT_MAX_CHARS=10000
KNOWLEDGE_EMBEDDING_DEVICE=auto
KNOWLEDGE_ALLOW_OCR=false

# Deterministic profiles, permissions and trust boundaries (Phase 6B). Profiles
# (locked/guest/standard/trusted/developer) are explicit policy bundles gated by ONE
# central authorize() with default-deny. NO profile (including developer) may bypass
# the mandatory invariants: recipient-specific confirmation, changed-target/hash
# revalidation, secret blocking, the document prompt-injection boundary, no automatic
# purchases/deletion/account changes, wake-cannot-confirm, duplicate-effect prevention.
# The OS user is the identity boundary; optional local unlock is Windows Hello or a
# SALTED password verifier (never plaintext, never in .env/logs). Temporary elevation
# is capability-scoped, visibly expiring, audited, and cleared on reboot. Off by
# default (backward compatible); when enabled it starts LOCKED. Profile changes need
# "confirmar cambio de perfil".
ENABLE_SECURITY_PROFILES=false
SECURITY_DEFAULT_PROFILE=standard
SECURITY_LOCK_ON_START=true
SECURITY_IDLE_LOCK_MINUTES=15
SECURITY_ALLOW_WINDOWS_HELLO=true
SECURITY_ALLOW_LOCAL_PASSWORD=true
SECURITY_TEMP_ELEVATION_MINUTES=10
SECURITY_MAX_FAILED_UNLOCKS=5
SECURITY_LOCKOUT_MINUTES=5

# Native desktop app bridge (Phase 6C). The PySide6 desktop client is a THIN
# presentation layer over this localhost API — no business logic, no database writes.
# These endpoints mint a short-lived, in-memory UI session token (cleared on restart)
# and stream SAFE activity events (SSE); they are loopback-only and gated by the flag
# below (off by default). The desktop enforces: no raw HTML from web/email/documents
# (everything is escaped before display), no generic confirm (a confirmation card sends
# the EXACT domain phrase, never a bare "yes"), and localhost-only.
ENABLE_DESKTOP_BRIDGE=false
DESKTOP_BIND_HOST=127.0.0.1
DESKTOP_SESSION_TTL_MINUTES=30
DESKTOP_STREAM_HEARTBEAT_SECONDS=15
DESKTOP_STREAM_QUEUE_MAX=1000

# Safety: when true, sensitive actions require an explicit confirm=true
REQUIRE_CONFIRMATION=true

# Real execution (Phase 1.5). false = everything simulated (default).
# true = ONLY these safe actions run for real, on the Windows host:
#   open_folder (existing, non-system folders), open_app (allowlist below),
#   search_web (default browser). Everything else stays simulated or blocked.
ENABLE_REAL_WINDOWS_TOOLS=false

# Apps that open_app may launch (comma-separated canonical names)
ALLOWED_APPS=notepad,calculator,chrome,edge,explorer
