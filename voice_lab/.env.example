# Copy to voice_lab/.env — this file is read ONLY by the Voice Lab worker,
# never by the main project (which has its own .env). All variables are
# prefixed VOICE_LAB_.

# Loopback binding only; the worker must never be exposed to the network.
VOICE_LAB_HOST=127.0.0.1
VOICE_LAB_PORT=8766

# Profile used when active.json is missing.
VOICE_LAB_DEFAULT_PROFILE=fifi_warm

# Sentence used by preview/compare (the exact Phase 3D.0.1 comparison text).
VOICE_LAB_PREVIEW_TEXT=Hola, soy Fifi. El sistema está listo y en que putas te ayudo hoy?

# Neural engine defaults (profiles can override per voice).
VOICE_LAB_DEVICE=cuda
VOICE_LAB_DTYPE=float16

# Play synthesized audio on this host (Fifi speaks through the worker).
VOICE_LAB_PLAYBACK_ENABLED=true

# GPU coordination (Phase 3D.0.3). When VRAM is tight, may a job ask Ollama to
# unload its model temporarily? Default false: jobs return a clear, actionable
# message instead. Even when true, each job needs explicit consent from the UI,
# the unload is HTTP-only (never kills a process), and the model-keeper
# re-warms Ollama automatically (~60 s window).
VOICE_LAB_ALLOW_TEMPORARY_OLLAMA_UNLOAD=false
# Probe endpoints for the coordinator (defaults shown).
#VOICE_LAB_OLLAMA_URL=http://127.0.0.1:11434
#VOICE_LAB_MAIN_API_URL=http://127.0.0.1:8000

# Resource policy (Phase 3D.0.4). The target machine has 16 GB system RAM and
# 16 GB dedicated VRAM. Disk, system RAM, dedicated VRAM, and shared GPU
# memory are measured SEPARATELY (app/resources.py) and compared in bytes;
# refusals name the specific resource — a generic "no hay espacio" never
# appears. The old 3 GB thresholds caused FALSE rejections on this machine.
# VOICE_LAB_MIN_FREE_RAM_GB is an accepted alias for MIN_FREE_SYSTEM_RAM_GB.
VOICE_LAB_MIN_FREE_SYSTEM_RAM_GB=2.0
VOICE_LAB_MIN_FREE_VRAM_GB=2.0
VOICE_LAB_MIN_FREE_DISK_GB=5.0
# Bounded heavy-job worker: how many heavy (Qwen GPU) jobs may run at once.
VOICE_LAB_HEAVY_JOB_CONCURRENCY=1
# Exclusive design mode (default ON since 3D.0.4): before a heavy VoiceDesign
# job, unload unused Voice Lab models (gc + CUDA cache clear AFTER references
# are released). The main API is never stopped and Ollama is never touched by
# this setting; cached model files are never deleted.
VOICE_LAB_EXCLUSIVE_DESIGN_MODE=true
# Soft no-progress timeouts for heavy jobs (a reporting job is never killed).
VOICE_LAB_MODEL_LOAD_TIMEOUT_SECONDS=300
VOICE_LAB_GENERATION_TIMEOUT_SECONDS=180
VOICE_LAB_JOB_STALL_SECONDS=30

# RAM/VRAM-aware model orchestration (Phase 3D.0.5). The coordinator keeps only
# the ACTIVE voice's engine warm and reclaims idle heavy models — cached weights
# are never deleted, so re-loads read the local cache with zero downloads.
#   daily      — Ollama + Whisper + ONLY the active voice's TTS engine.
#   designer   — daily, but VoiceDesign is prioritized while creating identities.
#   low-memory — Kokoro / Windows fallback only; heavy Qwen models are refused.
# Switch live with:  python scripts/local_runtime.py voice-mode <mode>
VOICE_LAB_MODE=daily
# Release idle heavy (Qwen) models after N seconds with no synthesis AND no
# active job (0 disables idle unloading).
VOICE_LAB_IDLE_UNLOAD_SECONDS=300
# How many heavy (Qwen) models may be resident at once. Loading one more evicts
# the least-recently-used unused heavy model first (release -> gc -> CUDA clear).
VOICE_LAB_MAX_LOADED_HEAVY_MODELS=1
# Minimum free system RAM / dedicated VRAM before a heavy load (byte-exact).
VOICE_LAB_MIN_FREE_RAM_GB=2.0
# In designer mode ONLY, may a heavy VoiceDesign load free Ollama automatically
# (no per-job UI consent)? Default false: Ollama is left alone.
VOICE_LAB_DESIGNER_AUTO_UNLOAD_OLLAMA=false
# Include Kokoro in the response fallback chain (false = fall back to Windows TTS).
VOICE_LAB_ALLOW_KOKORO_FALLBACK=true
