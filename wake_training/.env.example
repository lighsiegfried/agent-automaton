# wake_training/.env — OPTIONAL overrides for the isolated trainer (Phase 3D.2).
# Copied to wake_training/.env by setup.py. The real defaults live in
# config/*.yaml and the CLI; set anything here only to override without editing
# YAML. This file configures TRAINING only — it never touches the main app's
# .env, its safety flags, or the installed runtime.

# Torch wheel index used by setup.py. RTX 50 / Blackwell (sm_120) needs cu128.
WAKE_TRAIN_TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu128

# Where `install` places the SELECTED model, relative to the project root. The
# runtime reads this exact path (WAKE_WORD_MODEL_PATH in the main .env).
WAKE_TRAIN_INSTALL_TARGET=models/wake_words/fifi.onnx

# Override the reproducible seed from config (leave unset to use config value).
# WAKE_TRAIN_SEED=1234

# piper-sample-generator checkout + voice model, populated by setup.py.
# WAKE_TRAIN_PIPER_PATH=piper-sample-generator
